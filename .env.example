SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_ALLOWED_USER_IDS=

# Unique name of this node: "acer" or "legion".
NODE_NAME=

# Shared by every Fly High control node. Generate one long random value and
# put the same value in every node's .env.
FLY_HIGH_CLUSTER_TOKEN=

# HTTP API exposed by each node to trusted peers on the private LAN/WARP network.
LISTEN_ADDR=:8787

# ALSA playback device for this node.
ANNOUNCE_AUDIO_DEVICE=default

# Maximum time allowed for a complete announcement command, including repeats.
# Example: a longer sentence repeated 10 times can exceed short HTTP timeouts.
ANNOUNCE_TIMEOUT=5m

# Comma-separated peer map in the form name=url.
# Acer example:
# PEERS=legion=http://192.168.0.10:8787
# Legion example:
# PEERS=acer=http://192.168.0.7:8787
PEERS=
